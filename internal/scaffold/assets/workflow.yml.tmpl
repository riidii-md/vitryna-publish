# Generated by Vitryna Publish [[ .Pins.Version ]]. Repository-owned; review changes.
name: Vitryna Publish
on:
  push:
    branches: [ [[ q .GitHub.TrustedSourceBranch ]] ]
  pull_request:
  workflow_dispatch:
    inputs:
      publish:
        description: Publish the current trusted source (otherwise preview only)
        type: boolean
        default: false
        required: false
permissions: {}
concurrency:
  group: [[ q (printf "vitryna-${{ github.repository }}-%s" .GitHub.Repository) ]]
  cancel-in-progress: false
env:
  SOURCE_REPOSITORY: [[ q .SourceRepository ]]
  SOURCE_COMMIT: ${{ github.event.pull_request.head.sha || github.sha }}
  SOURCE_REPOSITORY_ID: ${{ github.repository_id }}
  HEAD_REPOSITORY_ID: ${{ github.event.pull_request.head.repo.id || github.repository_id }}
  TARGET: [[ q .GitHub.Repository ]]
  BASE: [[ q .GitHub.BaseBranch ]]
  PROMOTION: [[ q .GitHub.PromotionBranch ]]
  TRUSTED_SOURCE: [[ q .GitHub.TrustedSourceBranch ]]
  GIT_CONFIG_NOSYSTEM: '1'
  GIT_CONFIG_GLOBAL: /dev/null
  GIT_TERMINAL_PROMPT: '0'
jobs:
  invalidate:
    if: [[ q (printf "${{ %s }}" .PublishCondition) ]]
    runs-on: ubuntu-24.04
    permissions:
      contents: read
    steps:
[[ template "bootstrap" . ]]
[[ template "checkout" . ]]
      - name: Disarm and close the older owned candidate
        env:
          VITRYNA_SOURCE_TOKEN: ${{ github.token }}
          VITRYNA_APP_CLIENT_ID: ${{ vars.VITRYNA_APP_CLIENT_ID }}
          VITRYNA_APP_PRIVATE_KEY: ${{ secrets.VITRYNA_APP_PRIVATE_KEY }}
        shell: bash
        run: |
          "${{ steps.vitryna.outputs.path }}" workflow invalidate \
            --repository "$GITHUB_WORKSPACE/source" --ref "$SOURCE_COMMIT" \
            --source-repository "$SOURCE_REPOSITORY" --source-commit "$SOURCE_COMMIT" \
            --target "$TARGET" --base "$BASE" --promotion "$PROMOTION" --trusted-source "$TRUSTED_SOURCE"
  seal:
    needs: invalidate
    if: [[ q (printf "${{ always() && (needs.invalidate.result == 'success' || (needs.invalidate.result == 'skipped' && !(%s))) }}" .PublishCondition) ]]
    runs-on: ubuntu-24.04
    permissions:
      contents: read
    outputs:
      source-commit: ${{ steps.seal.outputs.source-commit }}
      artifact-id: ${{ steps.upload.outputs.artifact-id }}
      artifact-digest: ${{ steps.upload.outputs.artifact-digest }}
    steps:
[[ template "bootstrap" . ]]
[[ template "checkout" . ]]
      - name: Export and seal original bytes before project commands
        id: seal
        shell: bash
        run: |
          "${{ steps.vitryna.outputs.path }}" export \
            --repository "$GITHUB_WORKSPACE/source" --ref "$SOURCE_COMMIT" \
            --output "$RUNNER_TEMP/vitryna-export" --receipt "$RUNNER_TEMP/vitryna-receipt.json"
          "${{ steps.vitryna.outputs.path }}" workflow seal \
            --tree "$RUNNER_TEMP/vitryna-export" --receipt "$RUNNER_TEMP/vitryna-receipt.json" \
            --output "$RUNNER_TEMP/vitryna-seal"
          printf 'source-commit=%s\n' "$SOURCE_COMMIT" >> "$GITHUB_OUTPUT"
      - uses: actions/upload-artifact@[[ .Upload.Commit ]] # [[ .Upload.Version ]]
        id: upload
        with:
          name: vitryna-${{ github.run_id }}-${{ github.run_attempt }}
          path: |
            ${{ runner.temp }}/vitryna-seal/tree.tar
            ${{ runner.temp }}/vitryna-seal/receipt.json
          archive: true
          overwrite: false
          if-no-files-found: error
          retention-days: 7
          compression-level: 0
  verify:
    needs: seal
    if: ${{ always() && needs.seal.result == 'success' }}
    runs-on: ubuntu-24.04
    permissions:
      actions: read
    steps:
[[ template "bootstrap" . ]]
      - name: Download original and create a checked disposable copy
        id: preverify
        env:
          VITRYNA_SOURCE_TOKEN: ${{ github.token }}
          ARTIFACT_ID: ${{ needs.seal.outputs.artifact-id }}
          ARTIFACT_DIGEST: ${{ needs.seal.outputs.artifact-digest }}
          SEALED_COMMIT: ${{ needs.seal.outputs.source-commit }}
        shell: bash
        run: |
          "${{ steps.vitryna.outputs.path }}" workflow verify-artifact \
            --source-repository "$SOURCE_REPOSITORY" --source-repository-id "$SOURCE_REPOSITORY_ID" \
            --artifact-head-repository-id "$HEAD_REPOSITORY_ID" --source-commit "$SEALED_COMMIT" \
            --run-id "$GITHUB_RUN_ID" --artifact-id "$ARTIFACT_ID" --artifact-digest "$ARTIFACT_DIGEST" \
            --output "$RUNNER_TEMP/vitryna-verify"
          receipt_sha256="$(sha256sum "$RUNNER_TEMP/vitryna-verify/receipt.json")"
          receipt_sha256="${receipt_sha256%% *}"
          printf 'receipt-sha256=%s\n' "$receipt_sha256" >> "$GITHUB_OUTPUT"
      - name: Project verification without target credentials
        id: project
        shell: bash
        working-directory: ${{ runner.temp }}/vitryna-verify/tree
        run: |
[[ indent 10 .VerifyCommand ]]
      - name: Reject source byte, inventory, or mode mutations
        id: postverify
        env:
          RECEIPT_SHA256: ${{ steps.preverify.outputs.receipt-sha256 }}
        shell: bash
        run: |
          "${{ steps.vitryna.outputs.path }}" workflow verify-artifact \
            --tree "$RUNNER_TEMP/vitryna-verify/tree" --receipt "$RUNNER_TEMP/vitryna-verify/receipt.json" \
            --receipt-sha256 "$RECEIPT_SHA256"
      - name: Preview diff from receipt-checked bytes (never a publication gate)
        id: compare
        env:
          RECEIPT_SHA256: ${{ steps.preverify.outputs.receipt-sha256 }}
        shell: bash
        run: |
          "${{ steps.vitryna.outputs.path }}" workflow compare \
            --tree "$RUNNER_TEMP/vitryna-verify/tree" --receipt "$RUNNER_TEMP/vitryna-verify/receipt.json" \
            --receipt-sha256 "$RECEIPT_SHA256" \
            --target "$TARGET" --base "$BASE" --promotion "$PROMOTION"
  reconcile:
    needs: [invalidate, seal, verify]
    if: [[ q (printf "${{ always() && (%s) && needs.invalidate.result == 'success' && needs.seal.result == 'success' && needs.verify.result == 'success' }}" .PublishCondition) ]]
    runs-on: ubuntu-24.04
    permissions:
      contents: read
      actions: read
    steps:
[[ template "bootstrap" . ]]
[[ template "checkout" . ]]
      - name: Revalidate original seal and reconcile the owned public PR
        env:
          VITRYNA_SOURCE_TOKEN: ${{ github.token }}
          VITRYNA_APP_CLIENT_ID: ${{ vars.VITRYNA_APP_CLIENT_ID }}
          VITRYNA_APP_PRIVATE_KEY: ${{ secrets.VITRYNA_APP_PRIVATE_KEY }}
          ARTIFACT_ID: ${{ needs.seal.outputs.artifact-id }}
          ARTIFACT_DIGEST: ${{ needs.seal.outputs.artifact-digest }}
          SEALED_COMMIT: ${{ needs.seal.outputs.source-commit }}
        shell: bash
        run: |
          "${{ steps.vitryna.outputs.path }}" workflow reconcile \
            --repository "$GITHUB_WORKSPACE/source" --ref "$SEALED_COMMIT" \
            --source-repository "$SOURCE_REPOSITORY" --source-repository-id "$SOURCE_REPOSITORY_ID" \
            --source-commit "$SEALED_COMMIT" --run-id "$GITHUB_RUN_ID" \
            --artifact-id "$ARTIFACT_ID" --artifact-digest "$ARTIFACT_DIGEST" \
            --target "$TARGET" --base "$BASE" --promotion "$PROMOTION" --trusted-source "$TRUSTED_SOURCE"
[[ define "bootstrap" ]]      - name: Install the checksum-pinned public Vitryna binary (no App secrets)
        id: vitryna
        shell: bash
        run: |
          set -euo pipefail
          curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --tlsv1.2 \
            'https://github.com/riidii-md/vitryna-publish/releases/download/[[ .Pins.Version ]]/vitryna-linux-amd64' \
            --output "$RUNNER_TEMP/vitryna"
          printf '%s  %s\n' '[[ index .Pins.Binaries "linux-amd64" ]]' "$RUNNER_TEMP/vitryna" | sha256sum --check --status
          chmod 0755 "$RUNNER_TEMP/vitryna"
          printf 'path=%s\n' "$RUNNER_TEMP/vitryna" >> "$GITHUB_OUTPUT"
[[ end ]][[ define "checkout" ]]      - uses: actions/checkout@[[ .Checkout.Commit ]] # [[ .Checkout.Version ]]
        with:
          repository: ${{ github.repository }}
          ref: ${{ env.SOURCE_COMMIT }}
          path: source
          persist-credentials: false
          fetch-depth: 1
          fetch-tags: false
          submodules: false
          lfs: false
          set-safe-directory: false
[[ end ]]
